{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "ThreadAttentionDelivery": {
      "enum": [
        "started",
        "buffered"
      ],
      "type": "string"
    },
    "ThreadAttentionHeldReason": {
      "oneOf": [
        {
          "enum": [
            "blockingRequest",
            "busy",
            "planMode",
            "pendingTriggerTurn",
            "serverDraining"
          ],
          "type": "string"
        },
        {
          "description": "A durable intent exists but no final receipt survived. Never retry it blindly.",
          "enum": [
            "admissionUncertain"
          ],
          "type": "string"
        }
      ]
    }
  },
  "oneOf": [
    {
      "description": "Context admission only, not model consumption or operator authorization.",
      "properties": {
        "delivery": {
          "$ref": "#/definitions/ThreadAttentionDelivery"
        },
        "status": {
          "enum": [
            "accepted"
          ],
          "type": "string"
        },
        "turnId": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "delivery",
        "status"
      ],
      "type": "object"
    },
    {
      "properties": {
        "reason": {
          "$ref": "#/definitions/ThreadAttentionHeldReason"
        },
        "status": {
          "enum": [
            "held"
          ],
          "type": "string"
        }
      },
      "required": [
        "reason",
        "status"
      ],
      "type": "object"
    }
  ],
  "title": "ThreadAttentionResponse"
}